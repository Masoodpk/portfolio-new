# Copy to .env.local for local development, and add the same keys in your
# hosting provider's dashboard (e.g. Vercel → Settings → Environment Variables).
# These are server-only. Never prefix them with NEXT_PUBLIC_.

# Contact form email delivery via https://resend.com (optional).
# Without these the form shows a "email me directly" fallback.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
# Must be an address on a domain verified in Resend; the default test sender
# only delivers to the email you signed up to Resend with.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# Absolute production URL, used for canonical links, sitemap.xml, robots.txt,
# Open Graph images and structured data. On Vercel this falls back to the
# production deployment URL; set it once your custom domain is live.
SITE_URL=https://your-domain.com

# Google Search Console HTML-tag verification token (optional).
GOOGLE_SITE_VERIFICATION=
